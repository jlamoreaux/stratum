{
  "name": "@stratum/website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Public documentation site for Stratum, built with Astro Starlight.",
  "type": "module",
  "scripts": {
    "sync:openapi": "node -e \"require('fs').copyFileSync('../docs/api/openapi.yml', 'public/openapi.yml')\"",
    "predev": "npm run sync:openapi",
    "dev": "astro dev",
    "prebuild": "npm run sync:openapi",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.6.0",
    "sharp": "^0.34.0"
  }
}
